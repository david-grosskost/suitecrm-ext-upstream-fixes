{
    "name": "david-grosskost/suitecrm-ext-upstream-fixes",
    "description": "Correctifs de bugs de SuiteCRM, en attendant leur correction dans SuiteCRM.",
    "type": "suitecrm-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.26"
    },
    "autoload-dev": {
        "classmap": [
            "legacy/include/"
        ],
        "psr-4": {
            "SuiteCrmExt\\UpstreamFixes\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    }
}
